# Copy to .env and replace every placeholder before deploying.
# These two secrets MUST match front/.env.local exactly. They are
# service-to-service credentials, not admin/bot/JWT credentials.

PRIVACY_PROXY_SECRET=REPLACE_WITH_RANDOM_32_CHAR_PROXY_SECRET
PRIVACY_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SIGNING_SECRET

ANALYTICS_RETENTION_DAYS=180
ANALYTICS_CAMPAIGNS=
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=false

# SnappPay v2.1: reserved for the integration under development. The gateway is
# NOT enabled by these values alone; do not use it for production payments yet.
SNAPPAY_API_URL=
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
SNAPPAY_USERNAME=
SNAPPAY_PASSWORD=
SNAPPAY_CALLBACK_URL=
