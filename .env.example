# Copy to .env and replace every placeholder before deploying.
# These two secrets MUST match front/.env.local exactly. They are
# service-to-service credentials, not admin/bot/JWT credentials.

PRIVACY_PROXY_SECRET=REPLACE_WITH_RANDOM_32_CHAR_PROXY_SECRET
PRIVACY_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SIGNING_SECRET

ANALYTICS_RETENTION_DAYS=180
ANALYTICS_CAMPAIGNS=
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=false

# SnappPay v2.1 (see SNAPPAY_INTEGRATION.md for the full go-live runbook).
# The gateway stays hidden until SNAPPAY_ENABLED=true AND all credentials are
# set. Before enabling: whitelist the server outbound IP with SnappPay
# (curl https://whatisip.snapppay.ir/whatis/ip on the server) and register the
# callback domain with them.
SNAPPAY_ENABLED=false
# Staging: https://fms-gateway-staging.apps.public.teh-1.snappcloud.io
# Production URL is issued by SnappPay after their demo review.
SNAPPAY_API_URL=
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
SNAPPAY_USERNAME=
SNAPPAY_PASSWORD=
# Optional; defaults to {APP_URL}/api/payment/callback/snappay. The domain must
# match the return-url base registered with SnappPay.
SNAPPAY_CALLBACK_URL=
# Optional comma-separated subset of INSTALLMENT,FINANCING,POSTPAID. Empty =
# let the user see all of their active SnappPay methods.
SNAPPAY_PAYMENT_METHOD_TYPES=
# Optional cart-item fallbacks; defaults are the values from the API document.
SNAPPAY_DEFAULT_CATEGORY=
SNAPPAY_DEFAULT_COMMISSION_TYPE=100

# Torob order tracking is independent of the existing product API and defaults OFF.
TOROB_TRACKING_ENABLED=false
# Exact public Host (including port if applicable), passed through by the proxy.
TOROB_TRACKING_HOST=zoppinico.com
# Independent random secret >= 32 characters, identical to the Next server.
TOROB_ATTRIBUTION_SECRET=REPLACE_WITH_RANDOM_32_CHAR_TOROB_SECRET
