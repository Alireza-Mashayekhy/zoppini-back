# Copy to .env and replace every placeholder before deploying.
# These two secrets MUST match front/.env.local exactly. They are
# service-to-service credentials, not admin/bot/JWT credentials.

PRIVACY_PROXY_SECRET=REPLACE_WITH_RANDOM_32_CHAR_PROXY_SECRET
PRIVACY_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SIGNING_SECRET

# Required JWT signing secrets (must be strong random strings >= 32 chars).
# Missing secrets cause access/refresh token signing to fail during login/signup.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_32_CHAR_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_32_CHAR_JWT_REFRESH_SECRET

# Redis (OTP storage & rate-limit counters) and Ghasedak SMS gateway.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
GHASEDAK_API_KEY=

ANALYTICS_RETENTION_DAYS=180
ANALYTICS_CAMPAIGNS=
# Controlled-rollout (production) database settings. With
# TYPEORM_MIGRATIONS_RUN=false you MUST run `pnpm migration:run` in back/
# before starting a new build; otherwise features backed by migration-only
# tables (analytics_*, reports) fail at runtime, e.g. "Unknown column
# 'category'" on /reports/interest. For local development omit both lines:
# defaults are synchronize on (non-production only) and migrations auto-run.
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=false

# Diatech customer club. Set BASE_URL to the API host/root (without /api/v1);
# the backend adds /api/v1 to each club resource URL and /api/token for auth.
DIATECH_CLUB_BASE_URL=https://diatech-api.example.com
DIATECH_CLUB_USERNAME=
DIATECH_CLUB_PASSWORD=

# SnappPay v2.1 (see SNAPPAY_INTEGRATION.md for the full go-live runbook).
# The gateway stays hidden until SNAPPAY_ENABLED=true AND all credentials are
# set. Before enabling: whitelist the server outbound IP with SnappPay
# (curl https://whatisip.snapppay.ir/whatis/ip on the server) and register the
# callback domain with them.
SNAPPAY_ENABLED=false
# Staging: https://fms-gateway-staging.apps.public.teh-1.snappcloud.io
# Production URL is issued by SnappPay after their demo review.
SNAPPAY_API_URL=
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
SNAPPAY_USERNAME=
SNAPPAY_PASSWORD=
# Optional; defaults to {APP_URL}/api/payment/callback/snappay. The domain must
# match the return-url base registered with SnappPay. APP_URL may be given with
# or without its own /api suffix (https://site or https://site/api) — the
# backend never builds a duplicated /api/api/... path. If you set this value
# explicitly it must be the FULL callback URL, e.g.
#   https://zoppinico.com/api/payment/callback/snappay
# Verify the URL the server really sends from the admin panel:
#   GET /api/payment/snappay/admin/diagnostics
SNAPPAY_CALLBACK_URL=
# Optional comma-separated subset of INSTALLMENT,FINANCING,POSTPAID. Empty =
# let the user see all of their active SnappPay methods.
SNAPPAY_PAYMENT_METHOD_TYPES=
# Optional cart-item fallbacks; defaults are the values from the API document.
SNAPPAY_DEFAULT_CATEGORY=
SNAPPAY_DEFAULT_COMMISSION_TYPE=100

# Torob order tracking is independent of the existing product API and defaults OFF.
TOROB_TRACKING_ENABLED=false
# Exact public Host (including port if applicable), passed through by the proxy.
TOROB_TRACKING_HOST=zoppinico.com
# Independent random secret >= 32 characters, identical to the Next server.
TOROB_ATTRIBUTION_SECRET=REPLACE_WITH_RANDOM_32_CHAR_TOROB_SECRET

# ── راهکاران (ثبت فاکتور و عضویت وفاداری) ──────────────────────────────────
# بدون RAHKARAN_BASE_URL/USERNAME/PASSWORD سرویس راهکاران خاموش می‌ماند و
# ثبت فاکتور انجام نمی‌شود (سفارش‌ها پرداخت‌شده می‌مانند، فاکتور ثبت نمی‌شود).
RAHKARAN_BASE_URL=
RAHKARAN_USERNAME=
RAHKARAN_PASSWORD=
RAHKARAN_MACHINE_NAME=
# ورود خودکار در بوت؛ اگر false باشد اولین درخواست لاگین می‌کند.
RAHKARAN_AUTO_LOGIN=false
# فاصلهٔ Tick (نگه‌داشتن Session) به میلی‌ثانیه؛ پیش‌فرض ۳۰۰۰۰۰ (۵ دقیقه).
RAHKARAN_TICK_INTERVAL_MS=300000
# انبارهای فروش: پیش‌فرض خرده‌فروشی و انبار دوم (هدیش‌مال).
RAHKARAN_RETAIL_STORE_ID=20
RAHKARAN_HADISH_MALL_STORE_ID=23
# نام قدیمی RAHKARAN_RETAIL_STORE_ID؛ فقط به‌عنوان fallback خوانده می‌شود.
RAHKARAN_STOCK_STORE_ID=
